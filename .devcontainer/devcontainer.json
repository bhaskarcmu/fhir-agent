{
  "name": "Agentic Healthcare Platform",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "kubectl": "latest",
      "helm": "latest",
      "minikube": "none"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "eamodio.gitlens",
        "github.vscode-pull-request-GitHub",
        "googlecloudtools.cloudcode",
        "googlecloudtools.datacloud",
        "google.geminicodeassist",
        "hashicorp.terraform",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "redhat.java",
        "redhat.vscode-yaml",
        "rooveterinaryinc.roo-cline",
        "saoudrizwan.claude-dev",
        "vmware.vscode-spring-boot",
        "vscjava.vscode-gradle",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-dependency",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-java-test",
        "vscjava.vscode-maven"
      ]
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk-amd64",
    "CLAUDE_CODE_USE_BEDROCK": "0",
    "CLAUDE_CONFIG_DIR": "/workspaces/.claude-home",
    "CLAUDE_PROJECTS_BASE": "/workspaces/.claude-home/projects",
    "SPRING_DATASOURCE_DRIVER_CLASS_NAME": "org.postgresql.Driver",
    "HIBERNATE_DIALECT": "ca.uhn.fhir.jpa.model.dialect.HapiFhirPostgresDialect"
  },
  "onCreateCommand": "npm install -g @anthropic-ai/claude-code",
  "updateContentCommand": "bash .devcontainer/scripts/install-dependencies.sh",
  "postStartCommand": "bash .devcontainer/scripts/post-start.sh postStart",
  "postAttachCommand": "bash .devcontainer/scripts/post-start.sh postAttach",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "FHIR server", "onAutoForward": "notify" }
  }
}
