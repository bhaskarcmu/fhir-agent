# IDE / editor — track only curated, non-secret shared VS Code config;
# ignore all other (personal / machine-specific) files under .vscode/.
# Never commit secrets into any of these.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Kong database credentials — never commit the real secret
gateway/kong/kong-db-secret.yaml

# fhir-service Neon credentials — never commit the real secret
fhir-service/k8s/secret.yaml
.idea/
*.swp
*.swo
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java / Maven
target/
*.class
*.jar
*.war

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars

# Runtime secrets and logs
.env
.env.local
/workspaces/setup.log
~/.claude/config.json
