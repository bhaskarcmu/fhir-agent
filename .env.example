# Copy to .env and fill in your values. Never commit .env.
#   cp .env.example .env

# ── LLM provider (docs/phase6/decisions.md H4, H45-H49) ────────────────────────
# The MCP agent defaults to a self-hosted Ollama model with NO configuration
# needed here at all -- free, and PHI never leaves this host. Leave everything
# in this section commented out unless you want a different provider.
#
# To explicitly opt into Claude instead (a real, deliberate choice -- a present
# ANTHROPIC_API_KEY alone does NOT switch the default; LLM_PROVIDER must be set):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_API_KEY is also accepted in place of ANTHROPIC_API_KEY (the Ona secret name).

# To point Ollama at something other than the default localhost:11434, or to use
# a hosted OpenAI-compatible endpoint (DeepSeek/OpenRouter/Groq/self-hosted vLLM
# -- never a default, always explicit):
# LLM_PROVIDER=ollama              # or openai_compatible
# LLM_MODEL=llama3.2:1b            # required for openai_compatible; optional override otherwise
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=

# Set only on a real production deployment -- refuses to silently default to
# Ollama if LLM_PROVIDER above is left unset (a minimal guardrail; the fuller
# design is M7, not yet built):
# DEPLOYMENT_ENV=production

# ── FHIR server ───────────────────────────────────────────────────────────────
# Leave BOTH unset for the local Docker Compose demo: the compose file defaults
# FHIR_GATEWAY_URL to http://fhir:8080/fhir (the fhir container) with no API key.
#
# Local processes on the host (uvicorn / agent directly, no Kong):
#   FHIR_GATEWAY_URL=http://localhost:8080/fhir
#   FHIR_API_KEY=
#
# Deployed / Kong-gated (GCP): point at the Kong proxy and supply a key from
#   gateway/tools/create-key.sh (run behind: kubectl port-forward svc/kong-kong-proxy 8000:80 -n kong)
#   FHIR_GATEWAY_URL=http://localhost:8000/fhir
#   FHIR_API_KEY=your-kong-api-key

# ── Triage service ────────────────────────────────────────────────────────────
# Default matches Docker Compose port mapping.
TRIAGE_SERVICE_URL=http://localhost:8001

# ── Neon PostgreSQL (production only) ─────────────────────────────────────────
# Used by HAPI FHIR JPA in production. Not needed for local Docker Compose.
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/fhirdb?sslmode=require
